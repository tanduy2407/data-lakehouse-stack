# Copy this file to .env and adjust values before starting the stack.
# cp .env.example .env

# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_WAREHOUSE_BUCKET=warehouse

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=source_db

# Spark Configuration
SPARK_DRIVER_MEMORY=2G
SPARK_EXECUTOR_MEMORY=2G

# AWS Configuration (for MinIO S3 compatibility)
AWS_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
S3_PATH_STYLE_ACCESS=true

# Superset
SUPERSET_SECRET_KEY=superset-dev-secret-key-change-me
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Local
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@local.lab
SUPERSET_ADMIN_PASSWORD=admin